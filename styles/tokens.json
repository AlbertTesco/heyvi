  "layout": {
    "gutter": "clamp(var(--space-4), 5vw, var(--space-16))",
    "section-space": "clamp(var(--space-10), 5.25vw, var(--space-20))",
    "panel-space": "clamp(var(--space-4), 3vw, var(--space-8))",
    "column-gap": "clamp(var(--space-6), 5vw, var(--space-16))",
