  "breakpoints": {
    "nav-compact": "(max-width: 54rem)",
    "layout-compact": "(max-width: 49rem)",
    "phone": "(max-width: 34rem)",
    "phone-narrow": "(max-width: 23rem)",
    "motion-enabled": "(prefers-reduced-motion: no-preference)"
  }
